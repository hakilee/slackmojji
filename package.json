{
  "name": "slackmojji",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "yarn format:check && yarn lint && yarn design-system:check && yarn typecheck && yarn test && yarn build",
    "prepare": "husky",
    "icons": "node scripts/generate-icons.mjs",
    "design-system:inventory": "node scripts/design-system.mjs --write",
    "design-system:check": "node scripts/design-system.mjs"
  },
  "dependencies": {
